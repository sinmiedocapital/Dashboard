# Rename this file to .env and fill in your credentials
# All prop firm eval accounts run on Tradovate's DEMO environment
TRADOVATE_ENV=demo

# --- PRIMARY ACCOUNT (the one you trade on via TradingView) ---
PRIMARY_USERNAME=your_tradeify_username
PRIMARY_PASSWORD=your_tradeify_password
PRIMARY_DEVICE_ID=primary-copier-001

# --- FOLLOWER ACCOUNT 1 (Lucid Pro #1) ---
FOLLOWER1_USERNAME=your_lucid1_username
FOLLOWER1_PASSWORD=your_lucid1_password
FOLLOWER1_DEVICE_ID=follower1-copier-001

# --- FOLLOWER ACCOUNT 2 (Lucid Pro #2) ---
FOLLOWER2_USERNAME=your_lucid2_username
FOLLOWER2_PASSWORD=your_lucid2_password
FOLLOWER2_DEVICE_ID=follower2-copier-001

# Tradovate API credentials (same for all accounts — from your Tradovate API app)
# Get these at: https://trader.tradovate.com -> Preferences -> API Access
CID=your_cid
SEC=your_secret
APP_ID=Sample App
APP_VERSION=1.0
