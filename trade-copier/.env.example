# Copy this to .env and fill in your credentials
# Eval/prop firm accounts run on Tradovate's DEMO environment
TRADOVATE_ENV=demo

# --- PRIMARY ACCOUNT (connect THIS to TradingView — you trade here) ---
# Lucid Pro $50,400
PRIMARY_USERNAME=your_lucid_username
PRIMARY_PASSWORD=your_lucid_password
PRIMARY_DEVICE_ID=primary-001

# --- FOLLOWER ACCOUNT (mirrors every fill automatically) ---
# Tradeify $25,000
FOLLOWER_USERNAME=your_tradeify_username
FOLLOWER_PASSWORD=your_tradeify_password
FOLLOWER_DEVICE_ID=follower-001

# Tradovate API credentials — ONLY available on funded live accounts
# Steps to get these when you're funded:
#   1. Go to trader.tradovate.com (NOT demo)
#   2. Log in → click your name top-right → API Access
#   3. Click "Create Application" → name it anything → Save
#   4. Copy the CID (a number) and Secret and paste below
CID=PASTE_YOUR_CID_HERE
SEC=PASTE_YOUR_SECRET_HERE
APP_ID=Sample App
APP_VERSION=1.0

# Health check port (leave as-is for Railway/Fly.io)
PORT=8080
