# Copy this to .env and fill in CID + SEC (everything else is pre-filled)
# Eval/prop firm accounts run on Tradovate's DEMO environment
TRADOVATE_ENV=demo

# --- PRIMARY ACCOUNT (connect THIS one to TradingView — you trade here) ---
# Lucid Pro #1 — your main $50K account
PRIMARY_USERNAME=your_lucid1_username
PRIMARY_PASSWORD=your_lucid1_password
PRIMARY_DEVICE_ID=primary-001

# --- FOLLOWER ACCOUNT 1 ---
# Lucid Pro #2 — second $50K account
FOLLOWER1_USERNAME=your_lucid2_username
FOLLOWER1_PASSWORD=your_lucid2_password
FOLLOWER1_DEVICE_ID=follower1-001

# --- FOLLOWER ACCOUNT 2 ---
# Tradeify — backup account
FOLLOWER2_USERNAME=your_tradeify_username
FOLLOWER2_PASSWORD=your_tradeify_password
FOLLOWER2_DEVICE_ID=follower2-001

# Tradovate API App credentials
# Get at: demo.tradovate.com → top-right menu → API Access → Create App
CID=PASTE_YOUR_CID_HERE
SEC=PASTE_YOUR_SECRET_HERE
APP_ID=Sample App
APP_VERSION=1.0

# Health check port
PORT=8080
