//@version=6
// ============================================================
// SMC VRVP — Visible Range Volume Profile  v1.3
// Sin Miedo Capital | Commercial Invite-Only
// ============================================================
// Integration: In SMC Venice, use input.source() to read:
//   SMC_VRVP_ZoneState  (−2 to +5 numeric plot)
//   SMC_VRVP_POC / SMC_VRVP_VAH / SMC_VRVP_VAL  (price levels)
// All integration plots update on bar close only (non-repainting).
// Visible range is approximated via Fixed Lookback. Use the Lock
// toggle to freeze the profile before scrolling — prevents
// auto-recalculation as bars shift out of view.
// ============================================================
indicator("SMC VRVP", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=100)

// ─────────────────────────────────────────────────────────────
// SECTION 1 — INPUTS
// ─────────────────────────────────────────────────────────────

i_rangeMode = input.string("Fixed Lookback", "Range Mode",
                 options=["Fixed Lookback", "Session Current", "Session Prior"],
                 group="Range Settings")
i_lookback  = input.int(200,   "Lookback Bars", minval=10, maxval=2000, group="Range Settings")
i_lock      = input.bool(false, "Lock Profile",  group="Range Settings",
                 tooltip="Freeze the profile. Prevents recalculation when bars scroll out of view.")

i_numRows   = input.int(64,    "Profile Rows",              minval=10,  maxval=200, group="Profile Settings")
i_vaPercent = input.float(70.0, "Value Area %",             minval=1,   maxval=99,  group="Profile Settings")
i_hvnThresh = input.float(70.0, "HVN Threshold % of POC",  minval=10,  maxval=100, group="Profile Settings")
i_lvnThresh = input.float(25.0, "LVN Threshold % of POC",  minval=1,   maxval=50,  group="Profile Settings")
i_hvnCount  = input.int(3,     "Max HVNs Shown",            minval=1,   maxval=10,  group="Profile Settings")

i_showHistogram = input.bool(true, "Show Histogram",                group="Display")
i_showLines     = input.bool(true, "Show Key Level Lines",        group="Display")
i_histBars      = input.int(40,   "Histogram Width (bars)",      minval=5,  maxval=200, group="Display")
i_histPad       = input.int(0,    "Histogram Right Pad (bars)",  minval=0,  maxval=50,  group="Display",
                     tooltip="Shifts the histogram left of the current bar. 0 = right edge flush with last candle.")
i_lineWidth     = input.int(1,    "Line Width",                   minval=1,  maxval=4,   group="Display")
i_extLeft       = input.bool(true, "Extend Lines Left",           group="Display")

i_colPOC    = input.color(color.new(#7B1FA2, 0),  "POC",           group="Colors")
i_colHVNSup = input.color(color.new(#1B5E20, 0),  "HVN Support",   group="Colors")
i_colHVNRes = input.color(color.new(#B71C1C, 0),  "HVN Resistance",group="Colors")
i_colVAHL   = input.color(color.new(#9E9E9E, 0),  "VAH / VAL",     group="Colors")
i_colLVN    = input.color(color.new(#E65100, 0),  "LVN",           group="Colors")
i_colBuy    = input.color(color.new(#FFFFFF, 82), "Buy Volume",     group="Colors")
i_colSell   = input.color(color.new(#1565C0, 82), "Sell Volume",    group="Colors")

i_showPOC     = input.bool(true,  "POC Line",            group="Toggles")
i_showVAHL    = input.bool(true,  "VAH / VAL Lines",     group="Toggles")
i_showVAFill  = input.bool(true,  "Value Area Fill",     group="Toggles")
i_showHVN     = input.bool(true,  "HVN Lines",           group="Toggles")
i_showLVN     = input.bool(true,  "LVN Lines",           group="Toggles")
i_showTargets = input.bool(true,  "Target Labels",       group="Toggles")
i_showZone    = input.bool(true,  "Zone State Label",    group="Toggles")
i_showInfo    = input.bool(true,  "Profile Info Label",  group="Toggles")
i_alerts      = input.bool(true,  "Enable Alerts",       group="Toggles")

// ─────────────────────────────────────────────────────────────
// SECTION 2 — PERSISTENT STATE
// ─────────────────────────────────────────────────────────────

var float f_poc     = na
var float f_vah     = na
var float f_val     = na
var float f_rowSize = na

var int f_zoneState     = 0
var int f_zoneStateLive = 0
var int prevZone        = 0

var array<float> f_rPrices  = array.new<float>()
var array<float> f_rVols    = array.new<float>()
var array<float> f_rBuyVols = array.new<float>()
var array<float> f_hvns     = array.new<float>()
var array<float> f_lvns     = array.new<float>()

var array<line>  g_lines  = array.new<line>()
var array<label> g_labels = array.new<label>()
var array<box>   g_boxes  = array.new<box>()

// ─────────────────────────────────────────────────────────────
// SECTION 3 — CLEAR DRAWINGS
// ─────────────────────────────────────────────────────────────

clearDrawings() =>
    for ln in g_lines
        line.delete(ln)
    array.clear(g_lines)
    for lb in g_labels
        label.delete(lb)
    array.clear(g_labels)
    for bx in g_boxes
        box.delete(bx)
    array.clear(g_boxes)

// ─────────────────────────────────────────────────────────────
// SECTION 4 — CALC PROFILE
// ─────────────────────────────────────────────────────────────

calcProfile(startOff, endOff, numRows) =>
    safeStart = math.min(startOff, bar_index)
    safeEnd   = math.max(0, math.min(endOff, bar_index))

    priceHigh = high[safeEnd]
    priceLow  = low[safeEnd]

    for i = safeEnd + 1 to safeStart
        priceHigh := math.max(priceHigh, high[i])
        priceLow  := math.min(priceLow,  low[i])

    rowSz = (priceHigh - priceLow) / numRows
    if rowSz <= 0
        rowSz := syminfo.mintick

    rPrices  = array.new<float>(numRows, 0.0)
    rVols    = array.new<float>(numRows, 0.0)
    rBuyVols = array.new<float>(numRows, 0.0)

    for i = 0 to numRows - 1
        array.set(rPrices, i, priceLow + i * rowSz + rowSz / 2)

    totalVol = 0.0

    for i = safeEnd to safeStart
        barHigh = high[i]
        barLow  = low[i]
        barVol  = volume[i]
        barSpan = barHigh - barLow
        isBull  = close[i] >= open[i]

        for r = 0 to numRows - 1
            rowBot  = priceLow + r * rowSz
            rowTop  = rowBot + rowSz
            overlap = math.min(barHigh, rowTop) - math.max(barLow, rowBot)
            if overlap > 0
                frac     = barSpan > 0 ? overlap / barSpan : 1.0 / numRows
                volAlloc = barVol * frac
                array.set(rVols, r, array.get(rVols, r) + volAlloc)
                if isBull
                    array.set(rBuyVols, r, array.get(rBuyVols, r) + volAlloc)
                totalVol += volAlloc

    [rPrices, rVols, rBuyVols, totalVol]

// ─────────────────────────────────────────────────────────────
// SECTION 5 — CALC VALUE AREA
// ─────────────────────────────────────────────────────────────

calcValueArea(rVols, pocIdx, totalVol, vaPercent) =>
    target      = totalVol * vaPercent / 100.0
    accumulated = array.get(rVols, pocIdx)
    hi          = pocIdx
    lo          = pocIdx

    while accumulated < target
        upVol = hi + 1 < array.size(rVols) ? array.get(rVols, hi + 1) : 0.0
        dnVol = lo - 1 >= 0               ? array.get(rVols, lo - 1) : 0.0
        if upVol == 0.0 and dnVol == 0.0
            break
        if upVol >= dnVol
            hi          += 1
            accumulated += upVol
        else
            lo          -= 1
            accumulated += dnVol

    [lo, hi]

// ─────────────────────────────────────────────────────────────
// SECTION 6 — DETECT NODES
// ─────────────────────────────────────────────────────────────

detectNodes(rPrices, rVols, pocVol, hvnThresh, lvnThresh, maxHVN) =>
    hvnPrices = array.new<float>()
    hvnVols   = array.new<float>()
    lvnPrices = array.new<float>()

    n       = array.size(rVols)
    meanVol = 0.0
    for i = 0 to n - 1
        meanVol += array.get(rVols, i)
    meanVol /= n

    hvnMin = pocVol * hvnThresh / 100.0
    lvnMax = pocVol * lvnThresh / 100.0

    for i = 0 to n - 1
        v     = array.get(rVols,   i)
        p     = array.get(rPrices, i)
        prevV = i > 0     ? array.get(rVols, i - 1) : 0.0
        nextV = i < n - 1 ? array.get(rVols, i + 1) : 0.0

        if v >= hvnMin and v >= prevV and v >= nextV
            array.push(hvnPrices, p)
            array.push(hvnVols,   v)

        if v <= lvnMax and v <= meanVol
            array.push(lvnPrices, p)

    sortIdx = array.sort_indices(hvnVols, order.descending)
    topHVNs = array.new<float>()
    cap     = math.min(maxHVN, array.size(sortIdx))
    for i = 0 to cap - 1
        array.push(topHVNs, array.get(hvnPrices, array.get(sortIdx, i)))

    [topHVNs, lvnPrices]

// ─────────────────────────────────────────────────────────────
// SECTION 7 — CALC ZONE STATE
// ─────────────────────────────────────────────────────────────

calcZoneState(price, poc, vah, val, rowSz, hvns, lvns) =>
    state = 0

    if price > vah
        state := 1
    else if price < val
        state := -1
    else
        state := 0

    if math.abs(price - poc) <= rowSz
        state := 3
    else if math.abs(price - vah) <= rowSz or math.abs(price - val) <= rowSz
        state := 2

    for hvn in hvns
        if hvn > price and math.abs(price - hvn) <= rowSz * 2
            state := 5
        if hvn <= price and math.abs(price - hvn) <= rowSz * 2
            state := 4

    if state <= 0
        for lvn in lvns
            if math.abs(price - lvn) <= rowSz
                state := -2
                break

    state

// ─────────────────────────────────────────────────────────────
// SECTION 8 — ZONE TEXT / COLOR HELPERS
// ─────────────────────────────────────────────────────────────

zoneText(s) =>
    string txt = ""
    if s == -2
        txt := "LVN Vacuum"
    else if s == -1
        txt := "Below Value Area"
    else if s == 0
        txt := "Inside Value Area"
    else if s == 1
        txt := "Above Value Area"
    else if s == 2
        txt := "At VA Boundary"
    else if s == 3
        txt := "At POC"
    else if s == 4
        txt := "HVN Support"
    else if s == 5
        txt := "HVN Resistance"
    else
        txt := "—"
    txt

zoneColor(s) =>
    color c = color.gray
    if s == -2
        c := color.new(#E65100, 20)
    else if s == -1
        c := color.new(#B71C1C, 20)
    else if s == 0
        c := color.new(#9E9E9E, 40)
    else if s == 1
        c := color.new(#1B5E20, 20)
    else if s == 2
        c := color.new(#7B1FA2, 20)
    else if s == 3
        c := color.new(#7B1FA2, 0)
    else if s == 4
        c := color.new(#1B5E20, 0)
    else if s == 5
        c := color.new(#B71C1C, 0)
    else
        c := color.gray
    c

// ─────────────────────────────────────────────────────────────
// SECTION 9 — CONFIRMED RECALCULATION
// ─────────────────────────────────────────────────────────────

if barstate.isconfirmed and not i_lock
    startOff = 0
    endOff   = 0

    if i_rangeMode == "Fixed Lookback"
        startOff := i_lookback
        endOff   := 0

    else if i_rangeMode == "Session Current"
        sessionStart = 0
        i = 1
        while i <= bar_index
            if session.isfirstbar_regular[i]
                sessionStart := i
                break
            i += 1
        startOff := sessionStart
        endOff   := 0

    else
        sessionStart = 0
        priorEnd     = 0
        i = 1
        while i <= bar_index
            if session.isfirstbar_regular[i]
                if sessionStart == 0
                    sessionStart := i
                else
                    priorEnd     := sessionStart - 1
                    sessionStart := i
                    break
            i += 1
        startOff := sessionStart
        endOff   := priorEnd

    [rP, rV, rB, totV] = calcProfile(startOff, endOff, i_numRows)

    pocIdx = 0
    pocVol = 0.0
    for i = 0 to array.size(rV) - 1
        v = array.get(rV, i)
        if v > pocVol
            pocVol := v
            pocIdx := i

    [valIdx, vahIdx] = calcValueArea(rV, pocIdx, totV, i_vaPercent)

    f_poc     := array.get(rP, pocIdx)
    f_vah     := array.get(rP, vahIdx)
    f_val     := array.get(rP, valIdx)
    f_rowSize := array.size(rP) > 1 ?
         (array.get(rP, array.size(rP) - 1) - array.get(rP, 0)) / (array.size(rP) - 1) :
         syminfo.mintick

    array.clear(f_rPrices)
    array.clear(f_rVols)
    array.clear(f_rBuyVols)
    for i = 0 to array.size(rP) - 1
        array.push(f_rPrices,  array.get(rP, i))
        array.push(f_rVols,    array.get(rV, i))
        array.push(f_rBuyVols, array.get(rB, i))

    [hvns, lvns] = detectNodes(rP, rV, pocVol, i_hvnThresh, i_lvnThresh, i_hvnCount)

    array.clear(f_hvns)
    array.clear(f_lvns)
    for h in hvns
        array.push(f_hvns, h)
    for l in lvns
        array.push(f_lvns, l)

    f_zoneState := calcZoneState(close, f_poc, f_vah, f_val, f_rowSize, f_hvns, f_lvns)

// ─────────────────────────────────────────────────────────────
// SECTION 10 — DRAWING  (barstate.islast only)
// ─────────────────────────────────────────────────────────────

if barstate.islast and not na(f_poc)
    clearDrawings()

    cb        = bar_index
    extMode   = i_extLeft ? extend.left : extend.none
    histRight = cb - i_histPad
    labelX    = histRight + 1

    f_zoneStateLive := calcZoneState(close, f_poc, f_vah, f_val, f_rowSize, f_hvns, f_lvns)

    // ── BLOCK A: Histogram ──────────────────────────────────
    if i_showHistogram and array.size(f_rVols) > 0
        maxVol    = 0.0
        for i = 0 to array.size(f_rVols) - 1
            maxVol := math.max(maxVol, array.get(f_rVols, i))

        if maxVol > 0
            for i = 0 to array.size(f_rVols) - 1
                rv    = array.get(f_rVols,    i)
                rb    = array.get(f_rBuyVols, i)
                rp    = array.get(f_rPrices,  i)

                fullW = math.max(1, math.round(i_histBars * rv / maxVol))
                buyW  = math.min(fullW, math.round(fullW * rb / math.max(rv, 1e-10)))

                rowBot = rp - f_rowSize / 2
                rowTop = rp + f_rowSize / 2

                // Sell bar (full width, dark blue) — extends LEFT from histRight
                bxSell = box.new(
                     left         = histRight - fullW,
                     top          = rowTop,
                     right        = histRight,
                     bottom       = rowBot,
                     bgcolor      = i_colSell,
                     border_color = color.new(color.white, 100),
                     border_width = 0)
                array.push(g_boxes, bxSell)

                // Buy overlay (white, proportional) — anchored to RIGHT edge
                if buyW > 0
                    bxBuy = box.new(
                         left         = histRight - buyW,
                         top          = rowTop,
                         right        = histRight,
                         bottom       = rowBot,
                         bgcolor      = i_colBuy,
                         border_color = color.new(color.white, 100),
                         border_width = 0)
                    array.push(g_boxes, bxBuy)

        // Value Area fill
        if i_showVAFill
            fillLeft = math.max(0, cb - 5000)
            bxVA = box.new(
                 left         = fillLeft,
                 top          = f_vah,
                 right        = histRight,
                 bottom       = f_val,
                 bgcolor      = color.new(i_colVAHL, 92),
                 border_color = color.new(color.white, 100),
                 border_width = 0)
            array.push(g_boxes, bxVA)

    // ── BLOCK B: Key Level Lines ────────────────────────────
    if i_showLines
        if i_showPOC
            ln = line.new(cb, f_poc, cb - 1, f_poc,
                          xloc=xloc.bar_index, color=i_colPOC,
                          width=i_lineWidth + 1, extend=extMode)
            array.push(g_lines, ln)

        if i_showVAHL
            lnVAH = line.new(cb, f_vah, cb - 1, f_vah,
                             xloc=xloc.bar_index, color=i_colVAHL,
                             width=i_lineWidth, style=line.style_dashed, extend=extMode)
            array.push(g_lines, lnVAH)
            lnVAL = line.new(cb, f_val, cb - 1, f_val,
                             xloc=xloc.bar_index, color=i_colVAHL,
                             width=i_lineWidth, style=line.style_dashed, extend=extMode)
            array.push(g_lines, lnVAL)

        if i_showHVN
            for hvn in f_hvns
                hvnCol = hvn > close ? i_colHVNRes : i_colHVNSup
                lnH = line.new(cb, hvn, cb - 1, hvn,
                               xloc=xloc.bar_index, color=hvnCol,
                               width=i_lineWidth, extend=extMode)
                array.push(g_lines, lnH)

        if i_showLVN
            for lvn in f_lvns
                lnL = line.new(cb, lvn, cb - 1, lvn,
                               xloc=xloc.bar_index, color=i_colLVN,
                               width=i_lineWidth, style=line.style_dotted, extend=extMode)
                array.push(g_lines, lnL)

        // Target Labels — clean floating price text, no background box
        if i_showTargets
            nearAbove = float(na)
            nearBelow = float(na)
            for hvn in f_hvns
                if hvn > close
                    nearAbove := na(nearAbove) or hvn < nearAbove ? hvn : nearAbove
                else
                    nearBelow := na(nearBelow) or hvn > nearBelow ? hvn : nearBelow

            if not na(nearAbove)
                lbA = label.new(
                     x         = labelX,
                     y         = nearAbove,
                     text      = str.tostring(nearAbove, format.mintick),
                     xloc      = xloc.bar_index,
                     color     = color.new(color.white, 100),
                     textcolor = i_colHVNRes,
                     style     = label.style_label_left,
                     size      = size.small)
                array.push(g_labels, lbA)

            if not na(nearBelow)
                lbB = label.new(
                     x         = labelX,
                     y         = nearBelow,
                     text      = str.tostring(nearBelow, format.mintick),
                     xloc      = xloc.bar_index,
                     color     = color.new(color.white, 100),
                     textcolor = i_colHVNSup,
                     style     = label.style_label_left,
                     size      = size.small)
                array.push(g_labels, lbB)

    // Zone state label
    if i_showZone
        lbZ = label.new(
             x         = labelX,
             y         = f_vah,
             text      = zoneText(f_zoneStateLive),
             xloc      = xloc.bar_index,
             color     = zoneColor(f_zoneStateLive),
             textcolor = color.white,
             style     = label.style_label_left,
             size      = size.small)
        array.push(g_labels, lbZ)

    // Profile info watermark
    if i_showInfo
        rangeStr = i_rangeMode == "Fixed Lookback" ?
             str.tostring(i_lookback) + " bars" : i_rangeMode
        lockStr  = i_lock ? " · LOCKED" : ""
        lbI = label.new(
             x         = labelX,
             y         = f_poc,
             text      = "[" + rangeStr + lockStr + "]",
             xloc      = xloc.bar_index,
             color     = color.new(color.gray, 80),
             textcolor = color.new(color.gray, 40),
             style     = label.style_label_left,
             size      = size.tiny)
        array.push(g_labels, lbI)

// ─────────────────────────────────────────────────────────────
// SECTION 11 — INTEGRATION PLOTS (confirmed, non-repainting)
// ─────────────────────────────────────────────────────────────

plot(f_zoneState, "SMC_VRVP_ZoneState", display=display.none)
plot(f_poc,       "SMC_VRVP_POC",       display=display.none)
plot(f_vah,       "SMC_VRVP_VAH",       display=display.none)
plot(f_val,       "SMC_VRVP_VAL",       display=display.none)

// ─────────────────────────────────────────────────────────────
// SECTION 12 — ALERTS
// ─────────────────────────────────────────────────────────────

if barstate.isconfirmed and i_alerts and not na(f_poc)
    if f_zoneState != prevZone
        if f_zoneState == 0 and prevZone != 0
            alert("SMC VRVP: Price entered Value Area", alert.freq_once_per_bar_close)
        if f_zoneState == 3
            alert("SMC VRVP: Price at POC — key decision zone", alert.freq_once_per_bar_close)
        if f_zoneState == 5
            alert("SMC VRVP: Price approaching HVN Resistance", alert.freq_once_per_bar_close)
        if f_zoneState == 4
            alert("SMC VRVP: Price approaching HVN Support", alert.freq_once_per_bar_close)
        if f_zoneState == -2
            alert("SMC VRVP: Price in LVN — low resistance vacuum", alert.freq_once_per_bar_close)
    prevZone := f_zoneState
